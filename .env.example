PORT=3000
# GitHub Pages project sites share a host-wide origin (for example https://<account>.github.io).
# Replace <account> with your GitHub account if you are using a Pages project site,
# or use a dedicated frontend domain if you need tighter browser-origin isolation.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://<account>.github.io
AI_RESEARCH_PROVIDER=not-configured
AI_RESEARCH_API_KEY=
